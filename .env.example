# Copy to .env and fill in. Never commit real values (SEC-4).

# Neon Postgres connection string
DATABASE_URL=

# YouTube Data API v3 key (server only). Restrict it to the YouTube Data API in Google Cloud Console.
YOUTUBE_API_KEY=
# Channel handle whose covers fill the home page dashboard, e.g. @Repres_ENT
YOUTUBE_CHANNEL_HANDLE=

# Better Auth (SRS 6.4). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The app's own URL, e.g. http://localhost:3000 locally
BETTER_AUTH_URL=
# Google OAuth client (Web application). Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Who may sign in, as comma-separated Google emails. Anyone on neither list is refused.
ADMIN_EMAILS=
MEMBER_EMAILS=
