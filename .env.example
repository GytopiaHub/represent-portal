# Copy to .env and fill in. Never commit real values (SEC-4).

# Neon Postgres connection string
DATABASE_URL=

# YouTube Data API v3 key (server only). Restrict it to the YouTube Data API in Google Cloud Console.
YOUTUBE_API_KEY=
# Channel handle whose uploads fill the home page catalogue, e.g. @Repres_ENT
YOUTUBE_CHANNEL_HANDLE=
