# Copy to .env and fill in. Never commit real values (SEC-7).

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# AES-256-GCM key for Google tokens at rest (32 bytes, base64): openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# "mock" (default): Calendar + YouTube use seeded fake data. "live": real Google APIs.
GOOGLE_APIS=mock
YOUTUBE_API_KEY=

# Bearer token for /api/cron/tick (GitHub Actions + Vercel cron): openssl rand -hex 24
CRON_SECRET=
APP_URL=http://localhost:3000
# Only needed for `next start` outside Vercel (Vercel trusts its host automatically)
# AUTH_TRUST_HOST=true

# Local only: seeded as an active admin by `npm run db:reset`
SEED_ADMIN_EMAIL=
