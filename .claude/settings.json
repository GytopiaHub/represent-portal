{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-docs-sync.sh\"",
            "timeout": 30,
            "statusMessage": "Checking SRS and README are in sync"
          }
        ]
      }
    ]
  }
}
